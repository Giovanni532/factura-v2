# Copier en .env puis remplir. En local, une base SQLite suffit (pas de jeton).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Better-Auth : clé aléatoire (openssl rand -base64 32) et adresse de l'app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Connexion Google (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des factures et devis par e-mail (Resend)
RESEND_API_KEY=

# Abonnements (Stripe, clés de test)
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
